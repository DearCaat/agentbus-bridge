{
  "name": "agentbus",
  "version": "0.2.0",
  "description": "Self-hosted cross-harness, cross-machine messaging between live Claude Code and Codex sessions.",
  "author": {
    "name": "Wenhao Tang"
  },
  "mcpServers": {
    "agentbus": {
      "command": "python3",
      "args": [
        "-m",
        "agentbus",
        "mcp"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  },
  "license": "MIT",
  "repository": "https://github.com/DearCaat/agentbus-bridge",
  "homepage": "https://github.com/DearCaat/agentbus-bridge#readme"
}
